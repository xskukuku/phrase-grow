# Neon / PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional. A key entered in the app's Settings page is stored encrypted in the database.
# You can also provide it here; an environment key takes precedence over the saved one.
# DEEPSEEK_API_KEY=sk-...

# Optional, use a stable secret when deploying so saved API keys stay decryptable.
# APP_SECRET=replace-with-a-long-random-string

# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=8787
